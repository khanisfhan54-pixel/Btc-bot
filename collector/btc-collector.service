[Unit]
Description=BTCUSDT Perpetual ML Data Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/path/to/collector
Environment="PYTHONPATH=/path/to/collector"
EnvironmentFile=/path/to/collector/.env
ExecStart=/path/to/venv/bin/python /path/to/collector/run_collector.py
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
