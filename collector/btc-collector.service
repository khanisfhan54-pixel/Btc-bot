[Unit]
Description=BTCUSDT Perpetual ML Training Data Collector
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/path/to/Btc-bot
Environment="TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN"
EnvironmentFile=/etc/btc-collector.env
ExecStart=/usr/bin/python3 -m collector.run_collector
Restart=always
RestartSec=5
# Give the system time to cleanly flush parquets on stop
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
